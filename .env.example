# Set these in Laravel Cloud; start.sh does not load this file.
INSTANCE_NAME=convex
INSTANCE_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
CONVEX_CLOUD_ORIGIN=https://YOUR-BACKEND.laravel.cloud
CONVEX_BACKEND_VERSION=precompiled-2026-09-26-27ef234
# Attach MySQL with database name convex and a private bucket in Cloud.
# Cloud supplies DB_* or DATABASE_URL and AWS_* credentials.
DB_CONNECTION=mysql
# Lawn's attached PRIVATE Cloud MySQL endpoint required this workaround.
# Disables database TLS; do not use for public/external database connections.
# Remove it if your endpoint supports verified TLS. See README.md.
DO_NOT_REQUIRE_SSL=1
